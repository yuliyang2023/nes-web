# Patch a known working legacy image without rebuilding its 2017 toolchain.
# Pass --build-arg BASE_IMAGE=<tag of the current production image>.
ARG BASE_IMAGE=nfam/nes-web
FROM ${BASE_IMAGE}
COPY vendor/tsnes/legacy/nes.js /client/cdn/tsnes/dist/nes.js
# Also replace the old URL for clients with a cached SystemJS configuration.
COPY vendor/tsnes/legacy/nes.js /client/cdn/tsnes@0.0.2/dist/nes.min.js
COPY scripts/update-core-cache.js /tmp/update-core-cache.js
RUN node /tmp/update-core-cache.js
