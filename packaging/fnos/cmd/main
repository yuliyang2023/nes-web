#!/bin/bash
set -u
APP_DIR="${TRIM_APPDEST:?Missing TRIM_APPDEST}"
VAR_DIR="${TRIM_PKGVAR:?Missing TRIM_PKGVAR}"
NODE=/var/apps/nodejs_v24/target/bin/node
PID_FILE="$VAR_DIR/app.pid"
LOG_FILE="$VAR_DIR/app.log"
PORT="${TRIM_SERVICE_PORT:-8180}"

start_ticks() {
    local stat_line
    stat_line="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
    # comm may contain spaces; starttime is field 20 after its closing ')'.
    stat_line="${stat_line##*) }"
    awk '{print $20}' <<< "$stat_line"
}

running() {
    [ -r "$PID_FILE" ] || return 1
    read -r pid started < "$PID_FILE" || return 1
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    [ "$pid" -gt 1 ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    # fnOS restricts /proc/*/environ; stat starttime is readable by the app
    # user and prevents signalling an unrelated process after PID reuse.
    [ -n "$started" ] && [ "$(start_ticks "$pid")" = "$started" ]
}

prepare_data() {
    local shared roms="" screen=""
    local -a shares
    IFS=: read -r -a shares <<< "${TRIM_DATA_SHARE_PATHS:-}"
    for shared in "${shares[@]}"; do
        case "${shared%/}" in
            */roms) roms="${shared%/}" ;;
            */screen) screen="${shared%/}" ;;
        esac
    done
    if [ ! -d "$roms" ] || [ ! -d "$screen" ]; then
        echo 'ROM/封面共享目录不可用，请检查飞牛应用资源。' >> "$LOG_FILE"
        return 1
    fi
    mkdir -p "$APP_DIR/data" || return 1
    ln -sfnT "$roms" "$APP_DIR/data/roms" || return 1
    ln -sfnT "$screen" "$APP_DIR/data/screen" || return 1
}

case "${1:-}" in
    start)
        mkdir -p "$VAR_DIR" || exit 1
        running && exit 0
        [ -x "$NODE" ] || { echo '缺少 Node.js v24 运行时。' >> "$LOG_FILE"; exit 1; }
        prepare_data || exit 1
        cd "$APP_DIR" || exit 1
        NES_WEB_FPK_INSTANCE="$APP_DIR" nohup "$NODE" "$APP_DIR/server/index.js" --port "$PORT" >> "$LOG_FILE" 2>&1 < /dev/null &
        service_pid=$!
        started="$(start_ticks "$service_pid")" || exit 1
        printf '%s %s\n' "$service_pid" "$started" > "$PID_FILE"
        for attempt in {1..20}; do
            running || exit 1
            if curl --noproxy '*' -fsS --max-time 1 "http://127.0.0.1:$PORT/api/games/" > /dev/null 2>&1; then
                exit 0
            fi
            sleep 0.5
        done
        echo '服务启动超时，请检查 app.log。' >> "$LOG_FILE"
        "$0" stop
        exit 1
        ;;
    stop)
        if running; then
            kill -TERM "$pid" || exit 1
            for attempt in {1..20}; do
                running || break
                sleep 0.25
            done
            running && kill -KILL "$pid"
        fi
        if [ -f "$PID_FILE" ]; then unlink "$PID_FILE"; fi
        exit 0
        ;;
    status)
        running && exit 0
        exit 3
        ;;
    *) exit 1 ;;
esac
